PORT=3000
NODE_ENV=development

# Supabase browser-safe configuration. The publishable key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-publishable-key
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy Express/MySQL settings (used only by the preserved legacy app).
JWT_SECRET=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=must_app
DB_PASSWORD=replace-with-local-database-password
DB_NAME=must_results
LEGACY_DEMO_PASSWORD=
